# ---- Uwazi backend configuration ----
# Copy to .env and fill in real values. NEVER commit .env.

# Runtime
NODE_ENV=development
PORT=5000

# Database (Prisma / PostgreSQL - e.g. Supabase connection strings)
# Pooled connection for the app, direct connection for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth project (the one the FRONTEND signs in against).
# Used by the backend only to verify user access tokens.
SUPABASE_URL=https://YOUR-AUTH-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional: enables fast local JWT verification (legacy HS256 signing secret).
# SUPABASE_JWT_SECRET=

# Evidence file storage (Supabase Storage). The service key bypasses RLS: keep it
# server-side only. Without it, reports still save but attached files are skipped.
# SUPABASE_SERVICE_KEY=
# EVIDENCE_BUCKET=uwazi-evidence

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# Comma-separated emails that are granted the admin role on first sign-in.
ADMIN_EMAILS=

# Show Swagger UI at /api-docs (defaults: on in dev, off in prod).
ENABLE_API_DOCS=true

# Optional legacy Python analytics service. Leave unset to disable the proxy.
# In the combined Docker image (start.sh) the Python API listens on :8000:
# LEGACY_PROXY_TARGET=http://localhost:8000
